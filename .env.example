# Local database. SQLite is the MVP default.
DATABASE_URL=sqlite:///./data/ai_tool_intel.db

# Optional: set this to your own RSSHub instance to enable rsshub sources.
# Example: RSSHUB_BASE_URL=https://rsshub.example.com
RSSHUB_BASE_URL=

# HTTP request tuning.
REQUEST_TIMEOUT_SECONDS=20
REQUEST_RETRIES=2
USER_AGENT=AItool_scraping/0.1 (+https://example.local)

# Optional: generic API endpoint for later AI first-screening.
# The endpoint should accept JSON and return:
# {"keep": true, "score": 80, "category": "...", "reason": "...", "summary_cn": "..."}
AI_REVIEW_API_URL=
AI_REVIEW_API_KEY=
AI_REVIEW_MODEL=
AI_REVIEW_API_STYLE=generic_json
AI_REVIEW_TIMEOUT_SECONDS=30
# AI review only processes candidate_items with candidate_score >= this value.
# limit is only an upper bound; the run may process fewer items.
AI_REVIEW_MIN_CANDIDATE_SCORE=70

# Optional: AI claim extraction after ai_review.
# Defaults to AI_REVIEW_* when left empty.
CLAIM_EXTRACT_API_URL=
CLAIM_EXTRACT_API_KEY=
CLAIM_EXTRACT_MODEL=
CLAIM_EXTRACT_API_STYLE=generic_json
CLAIM_EXTRACT_TIMEOUT_SECONDS=30
CLAIM_EXTRACT_MIN_AI_SCORE=70

# Tavily evidence search. Keep the real key in local .env only.
EVIDENCE_SEARCH_PROVIDER=tavily
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
TAVILY_INCLUDE_RAW_CONTENT=false
TAVILY_TIMEOUT_SECONDS=20

# Optional: AI verification after evidence search.
# Defaults to AI_REVIEW_* when left empty.
AI_VERIFY_API_URL=
AI_VERIFY_API_KEY=
AI_VERIFY_MODEL=
AI_VERIFY_API_STYLE=generic_json
AI_VERIFY_TIMEOUT_SECONDS=60

# Final recommendation thresholds.
FINAL_REVIEW_MIN_SCORE=75
FINAL_REVIEW_MIN_CREDIBILITY=60
FINAL_REVIEW_MAX_SPAM_RISK=40

# Reserved for later stages; keep secrets in .env, never hard-code them.
DIFY_BASE_URL=
DIFY_API_KEY=
NOTION_API_KEY=
NOTION_DATABASE_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PRODUCTHUNT_TOKEN=
GITHUB_TOKEN=
