# Local database.
DATABASE_URL=sqlite:///./data/ai_tool_intel.db

# Shared HTTP client.
REQUEST_TIMEOUT_SECONDS=20
REQUEST_RETRIES=2
USER_AGENT=AItool_scraping/0.1 (+https://example.local)

# Optional RSSHub instance. Template-based RSSHub sources are skipped when empty.
RSSHUB_BASE_URL=

# Optional GitHub API access.
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_API_VERSION=2022-11-28
GITHUB_TIMEOUT_SECONDS=20

# Optional Product Hunt developer token for GraphQL votes/comments/rank metadata.
PRODUCTHUNT_API_URL=https://api.producthunt.com/v2/api/graphql
PRODUCTHUNT_API_TOKEN=

# One structured AI analysis per selected item.
AI_REVIEW_API_URL=
AI_REVIEW_API_KEY=
AI_REVIEW_MODEL=
AI_REVIEW_API_STYLE=generic_json
AI_REVIEW_TIMEOUT_SECONDS=30
