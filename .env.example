# Local database. SQLite is the MVP default.
DATABASE_URL=sqlite:///./data/ai_tool_intel.db

# Optional: set this to your own RSSHub instance to enable rsshub sources.
# Example: RSSHUB_BASE_URL=https://rsshub.example.com
RSSHUB_BASE_URL=

# HTTP request tuning.
REQUEST_TIMEOUT_SECONDS=20
REQUEST_RETRIES=2
USER_AGENT=AItool_scraping/0.1 (+https://example.local)

# Reserved for later stages; keep secrets in .env, never hard-code them.
DIFY_BASE_URL=
DIFY_API_KEY=
NOTION_API_KEY=
NOTION_DATABASE_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PRODUCTHUNT_TOKEN=
GITHUB_TOKEN=
