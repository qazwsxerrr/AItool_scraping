# Local database.
DATABASE_URL=sqlite:///./data/ai_tool_intel.db

# Shared HTTP client.
REQUEST_TIMEOUT_SECONDS=20
REQUEST_RETRIES=2
USER_AGENT=AItool_scraping/0.1 (+https://example.local)

# Optional outbound proxy for the Python/httpx clients. Leave blank to disable.
# The client uses HTTP/2 because some proxy/Cloudflare paths reject HTTP/1.1.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=127.0.0.1,localhost,::1

# Optional RSSHub instance. Template-based RSSHub sources are skipped when empty.
RSSHUB_BASE_URL=
# Local Node RSSHub settings. Keep RSSHUB_BASE_URL's port in sync with
# RSSHUB_PORT when using the local runner.
RSSHUB_PORT=1200

# Optional GitHub API access.
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN=
# Alias accepted when GITHUB_TOKEN is empty.
GITHUB_API_TOKEN=
GITHUB_API_VERSION=2022-11-28
GITHUB_TIMEOUT_SECONDS=20

# The Python app reaches X through RSSHub. Maintain all RSSHub credentials in
# this root file; the local runner is scripts/start_rsshub.sh.
TWITTER_AUTH_TOKEN=
PROXY_URI=http://127.0.0.1:2080

# OAuth 1.0a credentials are not used by this project's local RSSHub runner.
# It deliberately runs the TWITTER_AUTH_TOKEN path only.
# TWITTER_CONSUMER_KEY=
# TWITTER_CONSUMER_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=

# Shared OpenAI-compatible provider used by Stages A-D. Stage A/B/D use the
# explicitly selected structured-output protocol; Stage C remains on Responses
# for native function calling. Use a `/v1` base URL or a full `/v1/responses`
# endpoint so the unchanged Stage C client remains configured.
AI_REVIEW_API_URL=
AI_REVIEW_API_KEY=
AI_REVIEW_MODEL=
AI_REVIEW_TIMEOUT_SECONDS=30
AI_STRUCTURED_API_STYLE=responses
# B analyzes every Stage-A pass/uncertain item. Local admission keeps only
# the fixed score and AI-relevance gates at 60. There is no reserve budget.
AI_STAGE_C_TIMEOUT_SECONDS=120
# C agent defaults are 32 turns / 120 local calls / 16 Tavily searches.
# Larger explicit values are honored; 0 disables search for that stage.
AI_STAGE_C_AGENT_MAX_TURNS=32
AI_STAGE_C_AGENT_MAX_TOOL_CALLS=120
AI_STAGE_C_AGENT_MAX_WEB_SEARCHES=16
AI_STAGE_D_MAX_WEB_SEARCHES=6
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com
TAVILY_TIMEOUT_SECONDS=30
# Editorial topics shown in the UI. The configured AI model chooses one label
# per retained item; keep the list short and stable so the digest is readable.
AI_REVIEW_CATEGORIES=开发生态,模型发布,产品应用,行业动态,技术与洞察,前瞻与传闻
